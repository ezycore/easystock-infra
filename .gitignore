# Secrets live ONLY on the server, never in git.
**/.env
**/.env.*
.env
.env.*

# Dozzle's user database (bcrypt password hashes) + session keys. Server-only,
# same rule as .env — generate it on the box, never commit it.
dozzle/data/

# OS / editor cruft
.DS_Store
*.swp

# Caddy access logs — written on the server into infra/logs by the caddy container.
# Real visitor IPs, user agents and request paths: never in git.
infra/logs/
