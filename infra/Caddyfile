# Caddy reverse proxy — HTTPS front door for the whole EasyStock stack.
# One Caddy instance serves the apex, every staging/production host, and the
# *.ezycore.com workspace wildcard. Upstreams are app *container names* on the
# shared `edge` Docker network (see infra/docker-compose.yml + §10).
#
# Most certs come from Let's Encrypt automatically (HTTP-01). The *.ezycore.com
# wildcard uses a DNS-01 challenge via the Cloudflare plugin (needs a custom
# Caddy image + CLOUDFLARE_API_TOKEN — see Dockerfile + docker-compose.yml).
# Concrete-host certs are obtained at startup; until the app containers exist
# each returns HTTPS 502 — expected. Verify: curl -I https://rc-mc-api.ezycore.com

{
    email rashidul.karim7@gmail.com    # ACME account email (Let's Encrypt expiry notices). Change if you like.

    # On-demand TLS for customer CUSTOM DOMAINS. Before issuing a cert for an
    # unknown host, Caddy asks the backend whether that host is a verified/active
    # custom domain — prevents strangers pointing DNS at us to force cert issuance
    # (abuse / Let's-Encrypt rate limits). Secret-gated (DOMAIN_CHECK_SECRET must
    # be set on THIS caddy container; Caddy appends &domain=). Custom domains are
    # PRODUCTION only. See CUSTOM-DOMAINS-P1.md.
    on_demand_tls {
        ask http://backend-prod:5000/api/internal/domain-check?key={env.DOMAIN_CHECK_SECRET}
    }
}

# ---------- ACCESS LOGS ----------
# Caddy writes NO access log unless a site block asks for one. That is why the
# 2026-09-23 Next.js server-action probe (crafted `Next-Action` headers hitting
# app.ezycore.com and mc.ezycore.com) could not be traced to an IP: nothing on this
# box had ever recorded a request. Every site block below now imports one of these.
# Remove an import and that host goes dark again.
#
# JSON, one object per line, into a host bind mount (/opt/easystock/infra/logs on the
# server, see docker-compose.yml) so rollups and ban lists can read it without going
# into the container. Caddy does its own rolling and gzip — no logrotate needed.
#
# `client_ip` is the true visitor ONLY while the Cloudflare records stay "DNS only"
# (grey cloud, DEPLOYMENT.md §6). Switch a record to the orange cloud and every request
# on it reads as a Cloudflare IP until you add `trusted_proxies` + `client_ip_headers`
# here — the log keeps working, it just starts lying.
#
# Cookie / Authorization / Proxy-Authorization are redacted by Caddy itself because the
# global `log_credentials` option is off. Leave it off.
#
# These logs are SENSITIVE and the filter below is what keeps them merely sensitive
# rather than a credential store: some public routes carry their secret in the URL, not
# in a header. Redacted today:
#   /t/<token>                        shopper order tracking (storefront page + the API
#                                     route /api/storefront/<slug>/t/<token>) — the token
#                                     IS the authentication, a replayed one opens the order
#   /courier-webhooks/<provider>/<t>  per-store courier webhook token (URL-auth, pre-auth)
#   /orders/track?...                 lookup by order number + PHONE — shopper PII
# Add an alternative to the pattern for every new tokenized or PII-bearing URL.
# One `regexp` per field is the Caddy limit, so all of them share this one pattern:
# alternative 1 keeps its prefix in ${1}, alternative 2 keeps its in ${2}, and whichever
# did not match contributes an empty string.
(access_log_filter) {
    format filter {
        wrap json
        fields {
            request>uri regexp "(/t/|/courier-webhooks/[^/]+/)[^/?#]+|(/orders/track\?).*" "${1}${2}REDACTED"
        }
    }
}

# Production + custom domains. 30 days is the forensics window; it is also how far back
# a visitor rollup can ever be rebuilt, so do not shorten it without saying so.
(access_log) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 20
            roll_keep_for 720h
        }
        import access_log_filter
    }
}

# Staging — same shape, kept in its own file and for one week, so staging noise never
# pollutes a production rollup or an incident timeline.
(access_log_staging) {
    log {
        output file /var/log/caddy/access-staging.log {
            roll_size 20MiB
            roll_keep 5
            roll_keep_for 168h
        }
        import access_log_filter
    }
}

# Drop requests carrying a header only an attacker sends. `X-Middleware-Subrequest`
# is Next.js-internal: the middleware-auth bypass (CVE-2025-29927) works by sending
# it from outside. We run a patched Next, so this is not the fix — it stops the
# scanner traffic at the edge instead of spending a frontend render on each probe.
# One GCP host sent ~10,600 of them in two hours on 2026-10-27. No browser or
# legitimate client ever sets it. Imported by every block that serves the frontend.
(block_exploit_headers) {
    @exploit_headers header X-Middleware-Subrequest *
    abort @exploit_headers
}

# ---------- PRODUCTION ----------
app.ezycore.com {
    import access_log
    import block_exploit_headers
    reverse_proxy frontend-prod:3000
}
api.ezycore.com {
    import access_log
    reverse_proxy backend-prod:5000
}
mc.ezycore.com {
    import access_log
    reverse_proxy mc-admin-prod:4000
}
mc-api.ezycore.com {
    import access_log
    reverse_proxy mc-api-prod:6000
}

# Dozzle — admin-only live log viewer (replaced Portainer 2026-08-04).
# Since 2026-10-26 it is served ONLY through a Cloudflare Tunnel behind Cloudflare
# Access: the `cloudflared` container on the `edge` network forwards
# dozzle.ezycore.com straight to `dozzle:8080` and never passes through Caddy.
#
# This block exists to REFUSE the name, not to serve it. Proxying here again would
# reopen the bypass that was found live: a request sent straight to the server IP
# with this Host header skipped Cloudflare Access and reached Dozzle's own login,
# the only thing standing between the internet and the Docker socket. Deleting the
# block is just as wrong — the *.ezycore.com wildcard below would then answer for it.
dozzle.ezycore.com {
    import access_log
    abort
}

# GoAccess traffic dashboard (added 2026-10-27) — same arrangement as Dozzle: served
# ONLY through the Cloudflare Tunnel (cloudflared → stats-web:80) behind Access, see
# goaccess/docker-compose.yml. Refused here so the wildcard below cannot answer for it
# and a request straight to the server IP cannot skip Access. The page lists visitor IPs.
stats.ezycore.com {
    import access_log
    abort
}

# Every workspace subdomain (acme.ezycore.com, …) → the customer frontend.
# Explicit hosts above always win over this wildcard. Cert via Cloudflare DNS-01
# (needs CLOUDFLARE_API_TOKEN; see Dockerfile + docker-compose.yml).
*.ezycore.com {
    import access_log
    import block_exploit_headers
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy frontend-prod:3000
}

# ---------- STAGING ----------
rc.ezycore.com {
    import access_log_staging
    import block_exploit_headers
    reverse_proxy frontend-staging:3000
}
rc-api.ezycore.com {
    import access_log_staging
    reverse_proxy backend-staging:5000
}
rc-mc.ezycore.com {
    import access_log_staging
    reverse_proxy mc-admin-staging:4000
}
rc-mc-api.ezycore.com {
    import access_log_staging
    reverse_proxy mc-api-staging:6000
}

# DNS records required for the blocks above (most-specific wins over the wildcard):
#   @ (apex) → server IP      www → server IP      * (wildcard) → server IP
# Apex/www certs use HTTP-01; the wildcard uses Cloudflare DNS-01 (token required).

# ---------- FOREIGN DOMAINS ----------
# smsmv.com is not ours: its DNS (behind Cloudflare) still points at this server.
# Cloudflare reaches us over plain HTTP, so the requests landed on Caddy's automatic
# HTTP→HTTPS redirect, about 3,300 in a few days, mostly exploit scanners. HTTP-only
# on purpose: an HTTPS block would make Caddy try to get a certificate for a domain
# we do not control. HTTPS already fails at the TLS handshake, because the
# on-demand `ask` refuses it.
http://smsmv.com, http://*.smsmv.com {
    import access_log
    abort
}

# ---------- CUSTOM DOMAINS (production only) ----------
# Catch-all for customer custom domains (shop.acme.com, acme.com). Any host NOT
# matched by an explicit/​wildcard block above falls here: Caddy issues a per-host
# cert on demand via HTTP-01, gated by the global `on_demand_tls { ask ... }`
# block (only verified/active domains get a cert). Serves the PRODUCTION frontend.
#
# Staging custom domains are NOT supported: one catch-all → one upstream. A
# customer publishes either  CNAME → connect.ezycore.com  (subdomain) or
# A → <server IP>  (apex), plus the _ezycore-verify TXT record. Explicit hosts
# and *.ezycore.com always win over this block. See CUSTOM-DOMAINS-P1.md.
https:// {
    import access_log
    import block_exploit_headers
    tls {
        on_demand
    }
    reverse_proxy frontend-prod:3000
}
