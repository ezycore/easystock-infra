# ── easystock-backend runtime env ──────────────────────────────────────────────
# Copy to the server as BOTH:
#   /opt/easystock/production/.env.backend   (prod values)
#   /opt/easystock/staging/.env.backend      (staging values)
# Fill every blank. Never commit the filled-in file (it's gitignored).
#
# SOURCE OF TRUTH: this file must list every var `inventory-backend` reads from
# `process.env`. When that repo adds / removes / renames one, update this file in
# the SAME change — see the "Infra env templates" rule in inventory-backend/CLAUDE.md.
# Cross-check: grep -rhoE 'process\.env\.[A-Z0-9_]+' inventory-backend/src | sort -u

# REQUIRED. Several guards key off this exact string, and "unset" resolves to the
# LESS safe branch in one of them: `NODE_ENV !== "production"` re-enables the
# `http://*.localhost:3000` CORS origin meant for multi-tenant dev. The two
# misconfiguration warnings at boot (ROOT_DOMAIN, DOMAIN_CHECK_SECRET) also only
# fire when this equals "production", so an unset value silences them too.
NODE_ENV=production
PORT=5000                     # MUST be 5000 — Caddy proxies api.* → backend-prod:5000

# MongoDB Atlas — PROD cluster for production, STAGING cluster for staging. DB name = easystock.
MONGODB_URI=mongodb+srv://easystock_app:PASSWORD@cluster0.xxxxx.mongodb.net/easystock?retryWrites=true&w=majority

# Auth — REQUIRED in every environment. Generate a unique value per environment:
#   openssl rand -hex 48
#
# Leaving this blank USED TO BE SURVIVABLE and silently catastrophic: six call
# sites fell back to a literal committed to the backend repo, so a box
# provisioned straight from this template booted clean and signed staff tokens
# with a publicly known key — forgeable auth for any user in any tenant.
#
# Since 2026-08-09 the app refuses instead: `src/utils/jwt.ts` throws on the
# first token operation, so an empty value here fails login loudly at deploy
# time rather than quietly forever. Fill it in.
#
# Rotating it invalidates every issued token, i.e. signs everyone out. That is
# the intended blast radius; there is no key-id/rollover scheme.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AES-256-GCM master key for secrets at rest (storefront courier + payment-gateway
# credentials). Exactly 64 hex chars. REQUIRED in any environment where a merchant
# configures a courier or gateway — without it those saves throw. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unique per environment; rotating it orphans every credential already stored.
ENCRYPTION_KEY=

# ── URLs ──────────────────────────────────────────────────────────────────────
# Point CORS + links at THIS env's frontend:
#   production →  https://app.ezycore.com
#   staging    →  https://rc.ezycore.com
# REQUIRED. CORS_ORIGIN is a comma-separated allow-list — one origin is the norm
# here; extra entries are only for a second frontend host on the same backend.
# Workspace subdomains are covered by ROOT_DOMAIN below, not by this list.
CORS_ORIGIN=https://rc.ezycore.com
FRONTEND_URL=https://rc.ezycore.com
# Apex domain so CORS accepts every workspace subdomain (acme.ezycore.com) plus
# the apex/www. Same value in staging & production.
# REQUIRED in prod. Empty disables workspace-subdomain CORS *and* stops seeding the
# `<slug>.ezycore.com` row at signup — both silently. The custom-domain blocklist no
# longer depends on it (platform hosts are hardcoded since 2026-08-17), but everything
# else here does. The backend logs a warning at boot when this is empty in production.
ROOT_DOMAIN=ezycore.com

# Public origin of THIS API, no trailing slash. Baked into the courier webhook URLs
# handed to Pathao / Steadfast / eCourier, so a wrong value means providers post
# into the void. `BACKEND_URL` is the legacy fallback — set API_PUBLIC_URL, leave
# BACKEND_URL empty.
#   production →  https://api.ezycore.com
#   staging    →  https://rc-api.ezycore.com
API_PUBLIC_URL=https://rc-api.ezycore.com
BACKEND_URL=

# Shopper-facing storefront base. Resolution order: the org's active custom domain
# → STOREFRONT_URL_TEMPLATE → `{slug}.` prefixed onto STOREFRONT_BASE_URL's host
# with a `/shop` path. On subdomain hosting the template is the exact shape:
#   production →  https://{slug}.ezycore.com/shop
# STOREFRONT_BASE_URL falls back to FRONTEND_URL when empty.
STOREFRONT_URL_TEMPLATE=
STOREFRONT_BASE_URL=

# Public origin used to build the shopper OAuth redirect_uri:
#   ${OAUTH_CALLBACK_BASE}/api/storefront/oauth/{provider}/callback
# MUST be set in any deployed environment — the fallback derives from `req.protocol`,
# which behind a TLS-terminating Caddy is `http`, and Google rejects non-https
# redirect URIs → redirect_uri_mismatch. Register this exact string in the console.
OAUTH_CALLBACK_BASE=https://rc-api.ezycore.com

# Shared secret for the custom-domain on-demand-TLS `ask` endpoint. MUST match
# DOMAIN_CHECK_SECRET in /opt/easystock/infra/.env (the Caddy container). Custom
# domains are production only. Generate: openssl rand -hex 32. See CUSTOM-DOMAINS-P1.md.
#
# REQUIRED in prod if custom domains are sold. Since 2026-08-17 the endpoint fails
# CLOSED: empty here means /api/internal/domain-check answers 403 to everything, so
# Caddy cannot issue certificates and no custom domain reaches `active`. It used to
# skip its own guard when unset, which left a pre-auth endpoint that flips a domain
# to `active` open to anyone who could reach it. The backend logs a warning at boot
# when this is empty in production.
DOMAIN_CHECK_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
# Cloudflare R2 (image storage) — your real bucket creds
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
# The VPS provider blocks outbound SMTP, so use Resend's HTTP API (port 443).
# Provider: resend | smtp | log. Empty = auto-detect (RESEND_API_KEY → resend,
# else SMTP_HOST → smtp, else log-only).
EMAIL_PROVIDER=resend
# Per-environment Resend account key (separate accounts so staging/prod quotas
# don't collide). Lives only on the server.
RESEND_API_KEY=
# Sender on a Resend-verified domain — per environment:
#   production →  EasyStock <noreply@ezycore.com>
#   staging    →  EasyStock <noreply@rc.ezycore.com>
EMAIL_FROM="EasyStock <noreply@rc.ezycore.com>"
# Hosted PNG brand mark for emails (mail clients don't render SVG / data-URIs).
# Defaults to ${FRONTEND_URL}/logo/ezycore-mark.png — set only to override.
EMAIL_LOGO_URL=
# Signing secret for the Resend bounce/complaint webhook (Resend dashboard →
# Webhooks; starts `whsec_`). POST /api/email-webhooks/resend is public and its
# effect is "stop mailing this address", so with this UNSET the endpoint refuses
# every request — set it in any env on Resend, or bounces never suppress.
RESEND_WEBHOOK_SECRET=

# SMTP fallback — read only when EMAIL_PROVIDER resolves to smtp. Leave empty on
# the VPS (port 587 is blocked) unless you have a relay that actually works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyStock <no-reply@ezycore.com>"

# ── Merchant support contact ──────────────────────────────────────────────────
# Printed in the footer of every merchant-facing email. Not required — unset
# falls back to the production line below — but staging SHOULD override it, or
# test mail sends whoever receives it to the real support WhatsApp.
#   production →  8801915555256  (the live line; the built-in default)
#   staging    →  set to a test number, or leave the default and accept the risk
# Digits only, international form, no "+" and no spaces: it is rendered into a
# wa.me link, which rejects anything else.
SUPPORT_WHATSAPP=8801915555256
# When the line is staffed, per language. Empty → "every day, 8:00 AM – 12:00 AM"
# and its Bangla equivalent. Change these rather than redeploying the backend
# when support hours move.
SUPPORT_HOURS=
SUPPORT_HOURS_BN=

# ── SMS (BulkSMSBD) ───────────────────────────────────────────────────────────
# PLATFORM-level credentials: one BulkSMSBD account serves every tenant, so these
# are never per-org and never stored in the database. Launch is NON-MASKED — the
# sender is the gateway-assigned numeric id. Empty = the SMS channel stays inert.
SMS_BULKSMSBD_API_KEY=
SMS_BULKSMSBD_SENDER_ID=
# Optional host override, BASE ONLY — the provider appends `/smsapi` and
# `/getBalanceApi` itself, so a value ending in `/smsapi` yields `/api/smsapi/smsapi`
# (a 404 HTML page). Leave blank for https://bulksmsbd.net/api.
SMS_BULKSMSBD_BASE_URL=

# ── Shopper social login (storefront OAuth) ───────────────────────────────────
# No creds = no buttons on the storefront (availableProviders() is env-gated).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Mission Control alignment ─────────────────────────────────────────────────
# Restore window (minutes) for an MC-admin-scheduled workspace delete. MUST mirror
# MC's own delete grace, or the two disagree on how long "undo" lasts.
ADMIN_DELETE_GRACE_MINUTES=10

# ── Data retention (docs/plan/data-retention.md) ──────────────────────────────
# Master switch. Both the retention scheduler and the purge sweep are inert unless
# this is exactly "true".
RETENTION_ENABLED=false
# The purge sweep hard-deletes tenant data, so it must be OPTED INTO: any value
# other than "false" counts-and-logs only. Keep "true" until validated per env.
RETENTION_DRY_RUN=true
RETENTION_IDLE_DAYS=180          # free / never-paid + no login this long → lapsed (0 disables)
# These two MUST sum to 90 in EVERY environment. The Terms and Privacy Policy
# promise deletion "90 days after a subscription ends", and what the customer was
# told is the SUM, not the lapsed window alone. They read 90+30 until 2026-08-13,
# which deleted on day 120 — a month past the published policy. Raising either
# one means re-reading the legal copy in easystock-marketing (both locales) and
# bumping the pages' lastUpdated, not just editing this file.
RETENTION_LAPSED_DAYS=60         # lapsed this long → deletion scheduled
RETENTION_PURGE_GRACE_DAYS=30    # warning window before the purge actually runs
RETENTION_SCHEDULER_CRON=0 9 * * *  # Asia/Dhaka wall clock (PLATFORM_CRON_TIMEZONE). 09:00 = what production ran ("0 3" on a UTC server) before the zone was explicit
PURGE_SWEEP_CRON=*/5 * * * *     # every 5 min, so a 10-min MC-admin restore window is honored
# Abandoned-cart mirrors older than this are pruned by the same scheduler (so
# RETENTION_ENABLED / RETENTION_DRY_RUN gate it too). One document per browser per
# store, written on every add-to-cart — the only collection here that grows with
# traffic rather than with sales. 0 disables the prune.
RETENTION_CART_DAYS=30

# ── Abandoned-cart recovery (backend docs/features/abandoned-cart.md) ─────────
# ⚠️ This job sends MARKETING email to real customers. TWO switches must both be
# on: this one (the operator's platform-wide kill switch) and each merchant's own
# Store settings → Checkout toggle, which is off by default. Neither implies the
# other — this exists so a deliverability incident can be stopped for every
# tenant at once without touching tenant data.
# Production: keep "false" until the feature is signed off.
CART_RECOVERY_ENABLED=false
CART_RECOVERY_CRON=*/15 * * * *  # first reminder is due at 60 min of inactivity (interval — independent of any timezone)

# ── Job / worker tuning (defaults are fine) ───────────────────────────────────
COURIER_SWEEP_CRON=*/30 * * * *  # courier tracking refresh cadence (interval — independent of any timezone)
COURIER_SWEEP_MAX=500            # orders refreshed per run
NOTIFICATION_ORG_TICK_LIMIT=20   # max outbox rows drained per org per worker tick
# Reports SMS segments spent on this box back to Mission Control, which owns the
# balance. Both environments: leave the default. With the job stopped the
# product's mirror falls with every message while MC's number stays where the
# last grant left it — the merchant and the admin then read different balances,
# and MC's is the one that settles a payment dispute. The cadence is how long
# they may legitimately disagree by, so lower it only if support asks.
SMS_USAGE_REPORT_CRON=*/15 * * * *  # usage report cadence (interval — independent of any timezone)
SMS_USAGE_REPORT_MAX=200            # workspaces reported per run

# ── API surface ───────────────────────────────────────────────────────────────
# API contract version in `meta.version` — NOT the release (that is package.json,
# served at GET /api/public/version).
API_VERSION=1.0
# GIT_SHA — DO NOT SET HERE. Baked into the image at build time by the deploy
# workflow (`--build-arg GIT_SHA=<commit>`); a value here would override it with a
# stale one. Empty → `/api/public/version` reports `commit: null`.
# Response-DTO contract enforcement: observe (default — validate + report, pass the
# original through) | enforce (parse, coerce, strip) | off. Keep `observe` in prod;
# `enforce` can strip a field a client still depends on.
API_CONTRACT_MODE=observe

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                   # console level (forced to debug when NODE_ENV=development)
FILE_LOG_LEVEL=info              # rotating file transport level
SERVICE_NAME=easystock-backend   # log `service` field + log filename prefix

# ── Telegram ops alerts ───────────────────────────────────────────────────────
# One bot per environment (staging bot vs prod bot).
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# --- Delivery-risk lookup (BDCourier) ---------------------------------------
# ONE product-level API key for the whole platform, owned by us — NOT per
# merchant. Every tenant's fraud check draws on this single metered quota
# (free + paid calls), which is why results are cached product-wide for 24h.
#
# production: REQUIRED for the order fraud check to consult real courier data.
# staging:    optional — leave blank unless you are testing the integration, so
#             staging traffic does not spend production's paid call allowance.
#
# When empty the fraud check returns 503 and the merchant is told to contact
# EzyCore. That is LOUD by design — there is no local-history fallback, because a
# score built from one merchant's own orders is silent on a first-time buyer,
# which is exactly the COD order carrying the most risk.
BDCOURIER_API_KEY=

# Which provider answers. Only "bdcourier" is implemented today; the adapter
# interface exists so switching is a new file plus this variable.
# production/staging: leave as the default unless a migration is underway.
FRAUD_CHECK_PROVIDER=bdcourier

# Cache window for a looked-up phone, in days (default 3). The calls are metered,
# but most lookups are for DISTINCT phones which no cache can dedupe — the saving
# is on re-checks of the same buyer. Kept short so a newly filed fraud report is
# not hidden. Raise only under quota pressure.
FRAUD_CHECK_CACHE_DAYS=3

# ── Meta Pixel & Conversions API ─────────────────────────────────────────────
# Server-side Purchase reporting to Meta, per merchant store. Two switches, both
# must be on: this one (platform) and the merchant's own in Store Settings → Meta.
# The platform switch exists so a deliverability/outage incident can be stopped for
# every tenant at once without touching tenant data.
# Production: "true" once signed off.  Staging: "false" — a staging order must
# never land in a real merchant's ad dataset.
META_CAPI_ENABLED=false
# Graph API version for Conversions API calls. Meta retires versions on a rolling
# ~2-year clock; when the current one nears expiry, bump this and redeploy — there
# is no code change. v26.0 released 2026-07-29, available until ~2028.
META_GRAPH_API_VERSION=v26.0
# Cron worker that drains the Meta event outbox. Keep "false" on staging: the rows
# would still be written (so the queue is inspectable) but nothing is sent.
META_EVENT_WORKER_ENABLED=false
